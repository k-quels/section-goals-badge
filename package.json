{
  "name": "section-goals-badge",
  "version": "1.0.1",
  "description": "Mobile-friendly floating character counter to set and track writing goals per section.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
